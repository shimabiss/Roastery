# このファイルを terraform.tfvars にコピーして使います。
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars は .gitignore 対象です。サブスクリプション ID などを
# リポジトリにコミットしないための措置です。

# --- 命名規則を構成する要素 -------------------------------------------------
#   <種別>-<ワークロード>-<環境>-<リージョン>-<連番>
#   例: log-roastery-dev-je-001
#
# environment : prd / stg / dev
# location    : japaneast (je) / japanwest (jw)
#               増やす場合は location_abbreviations に略号を追加する

# workload    = "roastery"
# environment = "dev"
# location    = "japaneast"
# instance    = "001"

# リージョンを増やす場合の例
# location_abbreviations = {
#   japaneast  = "je"
#   japanwest  = "jw"
#   eastus     = "eus"
# }

# --- その他 -----------------------------------------------------------------
# subscription_id   = "00000000-0000-0000-0000-000000000000"
# retention_in_days = 30
# daily_quota_gb    = 1

# tags = {
#   owner = "your-name"
# }

# --- Azure Container Apps (ADR-0003 Stage 2) --------------------------------

# **image_repository は必須です。** GHCR なら "<GitHubユーザー名>/roastery"。
# image_repository = "your-name/Roastery"

# デプロイするタグ。CI からはコミット SHA (sha-xxxxxxx) が渡されます。
# 手で apply するときは、GHCR に push 済みのタグを指定してください。
# image_tag = "main"

# Container Apps 一式を止めたいとき（Log Analytics と App Insights だけ残す）。
# **アイドル時に課金が出るのは postgres / redis / otel-collector の3つ**なので、
# 使わない期間は false にして apply すると止められます。
# deploy_container_apps = true

# 0 にするとアイドル時のコストがほぼゼロ。代わりに初回リクエストが遅くなります。
# min_replicas = 0
# max_replicas = 2

# CPU とメモリは組み合わせが決まっています。
#   0.25 -> 0.5Gi / 0.5 -> 1Gi / 0.75 -> 1.5Gi / 1 -> 2Gi
# container_cpu    = 0.25
# container_memory = "0.5Gi"
