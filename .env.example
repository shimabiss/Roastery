# --------------------------------------------------------------------------
# このファイルを .env にコピーして値を埋めてください。
#   cp .env.example .env
# --------------------------------------------------------------------------

# まずローカルだけで試す場合はこのファイルを触る必要はありません。
#   ./scripts/local-start.sh   を実行してください。
#
# Application Insights の接続文字列 (Azure に送る場合のみ必須)
# Azure Portal > Application Insights > 概要 > 「接続文字列」からコピー
# 例: InstrumentationKey=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx;IngestionEndpoint=https://japaneast-1.in.applicationinsights.azure.com/;LiveEndpoint=https://japaneast.livediagnostics.monitor.azure.com/
APPLICATIONINSIGHTS_CONNECTION_STRING=

# 環境名。App Insights / Jaeger 側で環境を絞り込むためのラベルになる。
DEPLOY_ENV=workshop

# Collector の設定ファイル
#   config.yaml       ... Azure Monitor + ローカル (Jaeger/Prometheus) に同時送信 (既定)
#   config.local.yaml ... ローカルのみ。Azure を使わない検証時はこちら
COLLECTOR_CONFIG=config.yaml

# Collector のイメージタグ。再現性が要る場面では固定推奨 (例: 0.132.0)
COLLECTOR_VERSION=latest
